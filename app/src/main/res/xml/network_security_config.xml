<?xml version="1.0" encoding="utf-8"?>
<!--
    PATCH: разрешаем cleartext (обычный http://, без TLS) HTTP-трафик для
    AiaChasingTrustManager (см. sstp/.../terminal/AiaChasingTrustManager.kt) —
    он при провале проверки цепочки сертификата сам скачивает недостающий
    промежуточный сертификат по ссылке из самого сертификата сервера (AIA,
    Authority Information Access). У большинства центров сертификации
    (включая GlobalSign) эти ссылки исторически именно http://, не https://
    — это повсеместная практика, не ошибка конкретного CA. С Android 9+
    cleartext-трафик заблокирован по умолчанию, если явно не разрешить —
    без этого файла AIA chasing падает с "Cleartext HTTP traffic ... not
    permitted" ещё до попытки соединения.

    Почему это безопасно, а не дыра: даже если сеть скомпрометирована и кто-то
    подменит ответ на этот конкретный HTTP-запрос — итоговая проверка цепочки
    сертификата (в AiaChasingTrustManager.checkServerTrusted) всё равно требует
    настоящей криптографической подписи до системного доверенного корневого
    сертификата. Подделать её без приватного ключа реального CA нельзя —
    подмена в худшем случае просто сломает попытку автодогрузки (проверка
    как и раньше провалится), а не обманет доверие.

    Область действия — весь домен-агностичный http(s)-трафик приложения:
    сузить до конкретных CA-доменов заранее нельзя, т.к. AIA-ссылка зависит
    от того, каким конкретно центром сертификации подписан сервер, к
    которому подключается пользователь (заранее неизвестно).
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true" />
</network-security-config>
